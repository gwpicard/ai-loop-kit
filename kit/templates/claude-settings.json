{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm --recursive:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc*--prune*)",
      "Bash(gh issue edit * --add-label state:**)",
      "Bash(gh issue edit * --remove-label state:**)",
      "Bash(gh issue create * --label state:**)",
      "Bash(gh label create state:**)",
      "Bash(gh label edit state:**)",
      "Bash(gh label delete state:**)",
      "Bash(gh issue edit * --add-label shaping:**)",
      "Bash(gh issue edit * --remove-label shaping:**)",
      "Bash(gh issue create * --label shaping:**)",
      "Bash(gh label create shaping:**)",
      "Bash(gh label edit shaping:**)",
      "Bash(gh label delete shaping:**)",
      "Bash(gh issue edit * --add-label review:**)",
      "Bash(gh issue edit * --remove-label review:**)",
      "Bash(gh issue create * --label review:**)",
      "Bash(gh label create review:**)",
      "Bash(gh label edit review:**)",
      "Bash(gh label delete review:**)",
      "Bash(gh api *issues/*/labels*)",
      "Bash(gh pr merge:*)",
      "Bash(gh * pr merge:*)",
      "Bash(gh api *pulls/*/merge*)",
      "Bash(gh alias set*)",
      "Bash(gh alias import*)",
      "Bash(python* -m loop.run.pull_request*merge*)",
      "Bash(python* *pull_request.py*merge*)",
      "Bash(python* *gate.py*move*done*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git config alias.*)",
      "Bash(git config * alias.*)",
      "Edit(//**/.agents/pieces/**)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.claude/settings.local.json)",
      "Edit(//**/.github/workflows/**)",
      "Edit(//**/.githooks/**)",
      "Edit(//**/.agents/loop/policy.json)",
      "Edit(//**/.agents/loop/local.json)",
      "Edit(/{{KIT_DIR}}/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(gh auth token*)",
      "Bash(security find-*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(bat *.env*)",
      "Bash(cp *.env*)",
      "Bash(source *.env*)"
    ],
    "ask": [
      "Bash(python* *run.py*--merge-pre-approved*)"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "sh \"{{KIT_DIR}}/scripts/session-start.sh\" --claude-hook"
          }
        ]
      }
    ]
  },
  "sandbox": {
    "enabled": true,
    "failIfUnavailable": true,
    "allowUnsandboxedCommands": false,
    "filesystem": {
      "denyRead": [
        "~/.config/gh",
        "~/Library/Keychains"
      ],
      "denyWrite": [
        "{{KIT_DIR}}"
      ]
    }
  }
}
