{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git reset --hard:*)",
      "Bash(git push --force:*)",
      "Bash(git push -f:*)",
      "Bash(git clean -f:*)",
      "Bash(git clean -fd:*)",
      "Bash(rm -rf:*)",
      "Bash(git push * main)",
      "Bash(git push * main *)",
      "Bash(git push * +main)",
      "Bash(git push * +main *)",
      "Bash(git push *:main)",
      "Bash(git push *:main *)",
      "Bash(git push *refs/heads/main)",
      "Bash(git push *refs/heads/main *)",
      "Bash(rm -r:*)",
      "Bash(rm -R:*)",
      "Bash(rm -fr:*)",
      "Bash(rm -Rf:*)",
      "Bash(rm -fR:*)",
      "Bash(rm --recursive:*)",
      "Bash(git reflog expire:*)",
      "Bash(git gc*--prune*)",
      "Bash(gh alias set*)",
      "Bash(gh alias import*)",
      "Bash(git commit --no-verify*)",
      "Bash(git commit * --no-verify*)",
      "Bash(git commit -n*)",
      "Bash(git config core.hooksPath*)",
      "Bash(git config * core.hooksPath*)",
      "Bash(git config alias.*)",
      "Bash(git config * alias.*)",
      "Edit(//**/.claude/settings.json)",
      "Edit(//**/.github/workflows/**)",
      "Edit(//**/.githooks/**)",
      "Read(~/.config/gh/**)",
      "Read(~/Library/Keychains/**)",
      "Bash(gh auth token*)",
      "Bash(security find-*)",
      "Read(//**/.env)",
      "Read(//**/.env.*)",
      "Bash(cat *.env*)",
      "Bash(head *.env*)",
      "Bash(tail *.env*)",
      "Bash(less *.env*)",
      "Bash(more *.env*)",
      "Bash(grep *.env*)",
      "Bash(rg *.env*)",
      "Bash(sed *.env*)",
      "Bash(awk *.env*)",
      "Bash(bat *.env*)",
      "Bash(cp *.env*)",
      "Bash(source *.env*)",
      "Bash(git push * stable)",
      "Bash(git push * stable *)",
      "Bash(git push *:stable)",
      "Bash(git push *refs/heads/stable)",
      "Bash(gh release create:*)",
      "Bash(gh release edit:*)",
      "Bash(gh release delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh api -X DELETE:*)",
      "Bash(gh api --method DELETE:*)"
    ],
    "ask": [
      "Bash(gh pr merge:*)",
      "Bash(gh * pr merge:*)",
      "Bash(gh api *pulls/*/merge*)"
    ]
  }
}
