#!/usr/bin/env python3
"""A stand-in for the GitHub CLI, for measuring the kit without a GitHub account.

The replay harness stands each scenario up in a throwaway folder. Real issues
would need a real repository per run, which means an account, a network, and
thirty repositories a pass. So this answers instead.

It is not a GitHub simulator. It knows the commands the kit actually uses, and
it refuses everything else loudly rather than returning something plausible. A
refusal is written to the log and to stderr, so a scenario that reaches for
something unsupported shows up in the transcript rather than passing quietly.

That refusal list is the useful output. The skills tell the agent what to do in
prose, so nobody knows the full set of commands it invents until it is watched.

State lives in one JSON file, named by FAKE_GH_STATE, so a run can be inspected
after it finishes.
"""

import json
import os
import re
import subprocess
import sys

STATE = os.environ.get("FAKE_GH_STATE", ".gh-fixture.json")
LOG = os.environ.get("FAKE_GH_LOG", STATE + ".log")


def load():
    if not os.path.exists(STATE):
        return {"repo": "rehearsal/project", "next": 1, "issues": []}
    with open(STATE) as handle:
        return json.load(handle)


def save(state):
    with open(STATE, "w") as handle:
        json.dump(state, handle, indent=2)


def note(line):
    with open(LOG, "a") as handle:
        handle.write(line + "\n")


def unsupported(argv, why="not implemented"):
    note("UNSUPPORTED\t%s\t%s" % (" ".join(argv), why))
    sys.stderr.write(
        "gh (rehearsal stand-in): '%s' is not supported here (%s).\n"
        "This is the test harness, not the real GitHub CLI.\n" % (" ".join(argv), why))
    sys.exit(1)


def sub_summary(state, issue):
    """The parent's own view of its parts, as the list payload carries it."""
    children = issue.get("sub_issues", [])
    total = len(children)
    completed = sum(1 for c in children
                    if find(state, c) and find(state, c)["state"] == "closed")
    pct = int(100 * completed / total) if total else 0
    return {"total": total, "completed": completed, "percent_completed": pct}


def issue_public(state, issue):
    """One issue in the shape the REST list endpoint returns."""
    open_blockers = [b for b in issue.get("blocked_by", [])
                     if find(state, b) and find(state, b)["state"] == "open"]
    return {
        "number": issue["number"],
        "title": issue["title"],
        "body": issue.get("body", ""),
        "state": issue["state"],
        "html_url": "https://github.com/%s/issues/%s" % (state["repo"], issue["number"]),
        "labels": [{"name": n} for n in issue.get("labels", [])],
        "assignees": [{"login": a} for a in issue.get("assignees", [])],
        "issue_dependencies_summary": {
            "blocked_by": len(open_blockers),
            "blocking": 0,
            "total_blocked_by": len(issue.get("blocked_by", [])),
            "total_blocking": 0,
        },
        "sub_issues_summary": sub_summary(state, issue),
    }


def find(state, number):
    for issue in state["issues"]:
        if issue["number"] == int(number):
            return issue
    return None


def origin_path():
    """The project's remote as a path Git can reach, or None without one.

    A relative remote is relative to the project, not to wherever Git runs.
    """
    done = subprocess.run(["git", "remote", "get-url", "origin"],
                          capture_output=True, text=True)
    if done.returncode != 0:
        return None
    remote = done.stdout.strip()
    if not os.path.isabs(remote) and "://" not in remote:
        remote = os.path.abspath(remote)
    return remote


def remote_heads(remote):
    """The branches on the remote, as {name: sha}. Empty for an empty remote."""
    if not remote:
        return {}
    done = subprocess.run(["git", "ls-remote", "--heads", remote],
                          capture_output=True, text=True)
    heads = {}
    for line in done.stdout.splitlines():
        sha, _, ref = line.partition("\t")
        if ref.startswith("refs/heads/"):
            heads[ref[len("refs/heads/"):]] = sha
    return heads


def print_json_or_jq(argv, payload):
    """Print the payload, or the part a --jq dotted path such as .visibility names.

    Anything richer than a dotted path is refused rather than guessed at, so a
    filter nobody modelled shows up in the log.
    """
    expression = flag(argv, "--jq") or flag(argv, "-q")
    if expression is None:
        print(json.dumps(payload))
        return
    if not re.fullmatch(r"(\.[A-Za-z_][A-Za-z0-9_]*)+", expression):
        unsupported(argv, "unmodelled --jq filter")
    value = payload
    for key in expression.strip(".").split("."):
        value = value.get(key) if isinstance(value, dict) else None
    if value is None:
        print("null")
    elif isinstance(value, (dict, list)):
        print(json.dumps(value))
    elif isinstance(value, bool):
        print("true" if value else "false")
    else:
        print(value)


def land_on_remote(pr):
    """Merge the pull request's branch into its base on the project's remote.

    Marking a pull request merged is not enough. A kit that checks the remote
    finds the fix missing from the base branch, and rightly says the fix never
    went live. So the merge happens in a throwaway clone and is pushed back.

    A project with no remote has nowhere to land it, so the pull request is only
    marked merged, as before. Returns False when Git cannot merge the branch.
    """
    import shutil
    import tempfile

    def git(*args, cwd=None):
        return subprocess.run(["git", *args], cwd=cwd, capture_output=True, text=True)

    remote = git("remote", "get-url", "origin")
    if remote.returncode != 0:
        return True
    remote = remote.stdout.strip()
    # A relative remote is relative to the project, not to the clone.
    if not os.path.isabs(remote) and "://" not in remote:
        remote = os.path.abspath(remote)
    head, base = pr.get("head", ""), pr.get("base", "main")
    work = tempfile.mkdtemp(prefix="fake-gh-merge-")
    try:
        clone = os.path.join(work, "clone")
        if git("clone", "-q", remote, clone).returncode != 0:
            return False
        who = ["-c", "user.name=Replay person", "-c", "user.email=person@example.invalid",
               "-c", "commit.gpgsign=false"]
        if git("checkout", "-q", base, cwd=clone).returncode != 0:
            # The harness starts every remote empty, so a scenario can tell a
            # push it made from one it did not. On GitHub the base branch
            # would already be there, so it is seeded from the project's own
            # base before the merge. Without this, every merge failed.
            if git("push", "-q", remote, "refs/heads/%s:refs/heads/%s" % (base, base)).returncode != 0:
                return False
            git("fetch", "-q", "origin", cwd=clone)
            if git("checkout", "-q", "-b", base, "origin/" + base, cwd=clone).returncode != 0:
                return False
        merged = git(*who, "merge", "-q", "--no-ff", "origin/" + head,
                     "-m", "Merge pull request #%s from %s" % (pr["number"], head), cwd=clone)
        if merged.returncode != 0:
            return False
        return git("push", "-q", "origin", base, cwd=clone).returncode == 0
    finally:
        shutil.rmtree(work, ignore_errors=True)


def current_branch():
    """The branch the scenario is standing on, or "" when Git cannot say."""
    try:
        done = subprocess.run(["git", "rev-parse", "--abbrev-ref", "HEAD"],
                              capture_output=True, text=True)
        return done.stdout.strip() if done.returncode == 0 else ""
    except OSError:
        return ""


def pulls(state):
    return state.setdefault("pull_requests", [])


def pr_url(state, pr):
    return "https://github.com/%s/pull/%s" % (state["repo"], pr["number"])


def head_oid(pr):
    """The commit at the tip of the pull request's branch.

    Read from the project while the pull request is open, so a later push moves
    it, and recorded when it merges, since a merged branch may be deleted.
    /maintain's stale-branch listing compares a branch against this.
    """
    if pr.get("head_oid"):
        return pr["head_oid"]
    head = pr.get("head", "")
    if not head:
        return ""
    for ref in ("refs/remotes/origin/" + head, "refs/heads/" + head):
        found = subprocess.run(["git", "rev-parse", "-q", "--verify", ref],
                               capture_output=True, text=True)
        if found.returncode == 0:
            return found.stdout.strip()
    return ""


def pr_fields(state, pr, names):
    """The subset of a pull request that --json asks for.

    The check reports as passing. A scenario's project is scaffolded with a
    working check, so on real GitHub it would run and pass, and a stand-in that
    reported otherwise would stop the kit's normal routine for a reason the kit
    did not cause.
    """
    available = {
        "number": pr["number"],
        "title": pr.get("title", ""),
        "body": pr.get("body", ""),
        "state": pr.get("state", "OPEN"),
        "url": pr_url(state, pr),
        "headRefName": pr.get("head", ""),
        "headRefOid": head_oid(pr),
        "baseRefName": pr.get("base", "main"),
        "mergeable": "MERGEABLE",
        "isDraft": False,
        "statusCheckRollup": [{
            "name": "project-check",
            "status": "COMPLETED",
            "conclusion": "SUCCESS",
            "state": "SUCCESS",
        }],
    }
    unknown = [n for n in names if n not in available]
    return {n: available[n] for n in names if n in available}, unknown


def find_pr(state, target):
    """A pull request by number, or by the branch it was opened from."""
    if target and target.isdigit():
        for pr in pulls(state):
            if pr["number"] == int(target):
                return pr
        return None
    branch = target or current_branch()
    for pr in reversed(pulls(state)):
        if pr.get("head") == branch:
            return pr
    return None


def flag(argv, name):
    """The value after --name, or None."""
    if name in argv:
        i = argv.index(name)
        if i + 1 < len(argv):
            return argv[i + 1]
    return None


def body_of(argv):
    """The body given with --body, or read from --body-file, or None.

    The kit writes a long body to a file and passes --body-file, or pipes it in
    with --body-file -, far more often than it quotes one on the command line.
    A stand-in that ignored the file stored an empty body, and a scenario that
    reads the body afterwards failed for a reason the kit did not cause.
    """
    body = flag(argv, "--body")
    if body is not None:
        return body
    path = flag(argv, "--body-file")
    if path is None:
        return None
    if path == "-":
        return sys.stdin.read()
    try:
        with open(path) as handle:
            return handle.read()
    except OSError:
        sys.stderr.write("open %s: no such file or directory\n" % path)
        sys.exit(1)


def on_remote(branch):
    """Whether the project's remote holds the branch. True with no remote.

    GitHub refuses a pull request whose base is not a branch on the repository.
    A stacked piece's base is another piece's branch, so a kit that opens the
    stacked pull request before uploading the branch under it is refused here
    as it would be there. A project with no remote cannot be asked, so it is
    let through, as before.

    The stand-in only ever asks a remote that is a folder on this computer, as
    every replay's is. An origin that is a network address is never contacted:
    the base counts as missing, and stderr says why.
    """
    try:
        remote = subprocess.run(["git", "remote", "get-url", "origin"],
                                capture_output=True, text=True)
        if remote.returncode != 0:
            return True
        url = remote.stdout.strip()
        if "://" in url or re.match(r"^[^/]+@[^/]+:", url) or not os.path.isdir(url):
            sys.stderr.write("gh (rehearsal stand-in): origin is not a folder on this "
                             "computer, so the branch %s is taken as missing\n" % branch)
            return False
        found = subprocess.run(["git", "ls-remote", "--exit-code", "--heads",
                                url, "refs/heads/" + branch],
                               capture_output=True, text=True)
        return found.returncode == 0
    except OSError:
        return True


def refuse_base(argv, base):
    """Refuse a base other than main that the remote does not hold, as GitHub does."""
    if base != "main" and not on_remote(base):
        note("REFUSED\t%s\tbase %s is not a branch on the remote" % (" ".join(argv), base))
        sys.stderr.write(
            "pull request create failed: GraphQL: Base ref must be a branch (%s)\n" % base)
        sys.exit(1)


def comment_body(comment):
    """A comment's text. An older state file keeps a comment as a bare string."""
    return comment if isinstance(comment, str) else comment.get("body", "")


def comment_id(issue, index, comment):
    """A comment's numeric id, as the REST API gives it.

    A new comment takes the next id from 1000001 up. A bare string from an
    older state file has none, so it gets one from its place, in a range of its
    own from 2000000000 up, so the two can never collide.
    """
    if isinstance(comment, dict) and "id" in comment:
        return comment["id"]
    return 2000000000 + issue["number"] * 10000 + index


def comment_node(number):
    """A comment's node id, as `gh issue view --json comments` gives it."""
    return "IC_kwDOReplay%s" % number


def actor(state):
    """The account the stand-in acts as: replay-person unless a scenario sets
    another in the state file's actor."""
    return state.get("actor") or "replay-person"


def comment_author(comment):
    """Who wrote a comment. One a fixture wrote with no author, as older state
    files hold, is the person's own."""
    if isinstance(comment, dict) and comment.get("author"):
        return comment["author"]
    return "replay-person"


def record_label(state, issue, kind, name):
    """Keep a labeled or unlabeled event, with the account that made it, as the
    issue's events endpoint lists them. The gate trusts a contract hash only
    from the account that added state:ready, so who acted has to be kept."""
    state["event_next"] = state.get("event_next", 5000001)
    issue.setdefault("events", []).append(
        {"id": state["event_next"], "event": kind, "actor": actor(state), "label": name,
         "created_at": "2026-10-05T12:00:%02dZ" % (len(issue["events"]) % 60)})
    state["event_next"] += 1


def rest_event(event):
    """One event in the shape the REST events endpoint returns."""
    who = event.get("actor")
    label = event.get("label")
    return {"id": event.get("id"), "event": event.get("event"),
            "actor": who if isinstance(who, dict) else {"login": who or "replay-person"},
            "label": label if isinstance(label, dict) else {"name": label or ""},
            "created_at": event.get("created_at") or "2026-10-05T12:00:00Z"}


def rest_comment(state, issue, index, comment):
    """One comment in the shape the REST comments endpoint returns."""
    number = comment_id(issue, index, comment)
    return {"id": number, "node_id": comment_node(number),
            "body": comment_body(comment), "user": {"login": comment_author(comment)},
            "html_url": "https://github.com/%s/issues/%s#issuecomment-%s"
                        % (state["repo"], issue["number"], number)}


def add_comment(state, issue, body):
    state["comment_next"] = state.get("comment_next", 1000001)
    made = {"id": state["comment_next"], "body": body, "author": actor(state)}
    state["comment_next"] += 1
    issue.setdefault("comments", []).append(made)
    return made


def flags_all(argv, name):
    out, i = [], 0
    while i < len(argv):
        if argv[i] == name and i + 1 < len(argv):
            out.append(argv[i + 1])
            i += 2
        else:
            i += 1
    return out


def api_fields(argv):
    """The key=value pairs given with -f, -F, --field or --raw-field."""
    out, i = {}, 0
    while i < len(argv):
        arg = argv[i]
        value = None
        if arg in ("-f", "-F", "--field", "--raw-field") and i + 1 < len(argv):
            value = argv[i + 1]
            i += 2
        elif arg.startswith(("--field=", "--raw-field=")):
            value = arg.split("=", 1)[1]
            i += 1
        else:
            i += 1
        if value is not None and "=" in value:
            key, _, val = value.partition("=")
            out[key] = val
    return out


def api_refs(argv, state, repo, rest, kind="refs"):
    """Read a branch, or create one, through the Git Data API.

    The first upload of a project creates `main` on GitHub at the commit its
    first piece was cut from, rather than pushing it. That is the one way the
    kit writes `main` other than by a merge, so it is modelled here and nothing
    else is: moving or deleting a branch through the API stays refused. The
    remote next door stands in for the repository, so a branch made here is a
    real branch there, which a later `git ls-remote` or merge will find.
    """
    if repo != state["repo"]:
        unsupported(argv, "not this project's repository")
    fields = api_fields(argv)
    method = None
    for i, arg in enumerate(argv):
        if arg in ("-X", "--method") and i + 1 < len(argv):
            method = argv[i + 1].upper()
        elif arg.startswith(("-X=", "--method=")):
            method = arg.split("=", 1)[1].upper()
    # gh sends POST on its own once a field is given.
    method = method or ("POST" if fields else "GET")
    remote = origin_path()

    def git(*args):
        return subprocess.run(["git", "-C", remote, *args], capture_output=True, text=True)

    # GitHub creates a branch only at git/refs. The singular git/ref reads one.
    if method == "POST" and not rest and kind == "refs":
        ref, sha = fields.get("ref", ""), fields.get("sha", "")
        if not ref.startswith("refs/heads/") or not sha:
            unsupported(argv, "a new branch needs ref=refs/heads/<name> and sha=<commit>")
        if not remote:
            unsupported(argv, "no remote to create the branch in")
        if git("cat-file", "-e", sha + "^{commit}").returncode != 0:
            sys.stderr.write('{"message":"Object does not exist","status":"422"}\n'
                             "gh: Object does not exist (HTTP 422)\n")
            sys.exit(1)
        if git("rev-parse", "-q", "--verify", ref).returncode == 0:
            sys.stderr.write('{"message":"Reference already exists","status":"422"}\n'
                             "gh: Reference already exists (HTTP 422)\n")
            sys.exit(1)
        if git("update-ref", ref, sha).returncode != 0:
            unsupported(argv, "the remote refused the new branch")
        state.setdefault("refs_created", []).append({"ref": ref, "sha": sha})
        save(state)
        print_json_or_jq(argv, {
            "ref": ref,
            "url": "https://api.github.com/repos/%s/git/%s" % (repo, ref),
            "object": {"sha": sha, "type": "commit"},
        })
        return

    if method == "GET":
        heads = remote_heads(remote)
        if not heads:
            sys.stderr.write('{"message":"Git Repository is empty.","status":"409"}\n'
                             "gh: Git Repository is empty. (HTTP 409)\n")
            sys.exit(1)
        wanted = (rest or "").rstrip("/")
        if wanted in ("", "heads"):
            print_json_or_jq(argv, [{"ref": "refs/heads/" + name,
                                     "object": {"sha": sha, "type": "commit"}}
                                    for name, sha in sorted(heads.items())])
            return
        if wanted.startswith("heads/") and wanted[len("heads/"):] in heads:
            name = wanted[len("heads/"):]
            print_json_or_jq(argv, {"ref": "refs/heads/" + name,
                                    "object": {"sha": heads[name], "type": "commit"}})
            return
        sys.stderr.write('{"message":"Not Found","status":"404"}\n'
                         "gh: Not Found (HTTP 404)\n")
        sys.exit(1)

    unsupported(argv, "unmodelled git refs call")


# The labels GitHub puts on a new repository, which founding deletes.
DEFAULT_LABELS = [
    ("bug", "d73a4a"), ("documentation", "0075ca"), ("duplicate", "cfd3d7"),
    ("enhancement", "a2eeef"), ("good first issue", "7057ff"),
    ("help wanted", "008672"), ("invalid", "e4e669"), ("question", "d876e3"),
    ("wontfix", "ffffff"),
]


def repo_labels(state):
    """The repository's labels. A state file that never named any starts with
    the nine a new repository has."""
    if "labels" not in state:
        state["labels"] = [{"name": n, "color": c, "description": ""}
                           for n, c in DEFAULT_LABELS]
    return state["labels"]


def fault(state, name):
    """A failure a scenario asked for, kept in the state file under faults."""
    return state.get("faults", {}).get(name)


def label_command(argv, state):
    """gh label list, create, edit and delete, as the real CLI answers them.

    A creation can be refused with faults.refuse_label_create, set to true for
    every label or to a list of names, the way an account without write access
    is refused.
    """
    sub = argv[1] if len(argv) > 1 else ""
    labels = repo_labels(state)
    named = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else None
    existing = next((l for l in labels if named and l["name"].lower() == named.lower()), None)

    if sub == "list":
        names = [n for n in (flag(argv, "--json") or "").split(",") if n]
        if names:
            unknown = [n for n in names if n not in ("name", "color", "description")]
            if unknown:
                unsupported(argv, "unmodelled label fields: %s" % ",".join(unknown))
            print(json.dumps([{n: l[n] for n in names} for l in labels]))
        else:
            for label in labels:
                print("%s\t%s\t#%s" % (label["name"], label["description"], label["color"]))
        return

    if sub == "create" and named:
        refused = fault(state, "refuse_label_create")
        if refused is True or (isinstance(refused, list) and named in refused):
            sys.stderr.write("HTTP 403: Resource not accessible by integration "
                             "(https://api.github.com/repos/%s/labels)\n" % state["repo"])
            sys.exit(1)
        color = (flag(argv, "--color") or flag(argv, "-c") or "ededed").lstrip("#")
        description = flag(argv, "--description") or flag(argv, "-d") or ""
        if existing and "--force" not in argv and "-f" not in argv:
            sys.stderr.write("label with name \"%s\" already exists; use `--force` "
                             "to update its color and description\n" % named)
            sys.exit(1)
        if existing:
            existing.update({"color": color, "description": description})
        else:
            labels.append({"name": named, "color": color, "description": description})
        save(state)
        return

    if sub in ("edit", "delete") and named:
        if existing is None:
            sys.stderr.write("label \"%s\" not found\n" % named)
            sys.exit(1)
        if sub == "delete":
            labels.remove(existing)
        else:
            for option, key in (("--color", "color"), ("--description", "description"),
                                ("--name", "name")):
                value = flag(argv, option)
                if value is not None:
                    existing[key] = value.lstrip("#") if key == "color" else value
        save(state)
        return

    unsupported(argv, "unmodelled label subcommand")


def read_issue_for_answer(state, issue):
    """Count a read of one issue, and apply a change a scenario set to land
    between two reads.

    faults.race is {"number": n, "on_read": k, "add": [...], "remove": [...]}:
    on the k-th read of issue n the labels change before the answer is given,
    as when a second session moves the same piece in between.
    """
    race = fault(state, "race")
    if not race or int(race.get("number", 0)) != issue["number"]:
        return
    race["reads"] = race.get("reads", 0) + 1
    if race["reads"] >= int(race.get("on_read", 2)):
        for name in race.get("add", []):
            if name not in issue["labels"]:
                issue["labels"].append(name)
        for name in race.get("remove", []):
            if name in issue["labels"]:
                issue["labels"].remove(name)
        del state["faults"]["race"]
    save(state)


def main():
    argv = sys.argv[1:]
    if not argv:
        unsupported(argv, "no command given")
    note("CALL\t%s" % " ".join(argv))
    state = load()
    command = argv[0]

    # A scenario can take GitHub away. Every call then fails the way the real
    # CLI fails with no network, so a script is seen to change nothing.
    if fault(state, "offline") and command not in ("--version", "version"):
        sys.stderr.write("error connecting to api.github.com\n"
                         "check your internet connection or https://githubstatus.com\n")
        sys.exit(1)

    if command in ("--version", "version"):
        print("gh version 2.0.0 (rehearsal stand-in)")
        return

    if command == "auth":
        print("Logged in to github.com as rehearsal")
        return

    if command == "repo" and len(argv) > 1 and argv[1] == "view":
        owner, _, name = state["repo"].partition("/")
        # An empty repository has no branch, so GitHub reports no default
        # branch for it until the first one arrives. The remote next door
        # stands in for the repository, so both are read from there.
        heads = remote_heads(origin_path())
        default = state.get("default_branch") or ("main" if "main" in heads else "")
        available = {
            "nameWithOwner": state["repo"],
            "name": name,
            "owner": {"login": owner},
            "url": "https://github.com/%s" % state["repo"],
            # The first upload names whether the repository is public or
            # private. A scenario may set it; private is what founding makes.
            "visibility": state.get("visibility", "PRIVATE"),
            "isPrivate": state.get("visibility", "PRIVATE") == "PRIVATE",
            "isEmpty": not heads,
            # GitHub answers null for an empty repository's default branch.
            "defaultBranchRef": {"name": default} if default in heads else None,
            "hasIssuesEnabled": True,
            # The rehearsal account owns the repository. The tooling check reads
            # this before founding, and refusing it left that check reporting
            # that no repository existed at all.
            "viewerPermission": "ADMIN",
            "deleteBranchOnMerge": bool(state.get("delete_branch_on_merge")),
        }
        names = [n for n in (flag(argv, "--json") or "").split(",") if n]
        if names:
            unknown = [n for n in names if n not in available]
            if unknown:
                unsupported(argv, "unmodelled repo fields: %s" % ",".join(unknown))
            print_json_or_jq(argv, {n: available[n] for n in names})
        else:
            print(json.dumps({"nameWithOwner": state["repo"]}))
        return

    if command == "repo" and len(argv) > 1 and argv[1] == "edit":
        # Two settings are answered. Founding switches on deleting a merged
        # branch, and the first upload makes main the default branch once it
        # exists. Anything else is a setting nobody modelled.
        rest = argv[2:]
        if rest and not rest[0].startswith("-"):
            if rest[0] != state["repo"]:
                unsupported(argv, "not this project's repository")
            rest = rest[1:]
        changes = {}
        i = 0
        while i < len(rest):
            if rest[i] == "--delete-branch-on-merge":
                changes["delete_branch_on_merge"] = True
                i += 1
            elif rest[i] == "--default-branch" and i + 1 < len(rest):
                changes["default_branch"] = rest[i + 1]
                i += 2
            elif rest[i].startswith("--default-branch="):
                changes["default_branch"] = rest[i].split("=", 1)[1]
                i += 1
            else:
                unsupported(argv, "unmodelled repo setting")
        if not changes:
            unsupported(argv, "unmodelled repo setting")
        branch = changes.get("default_branch")
        if branch is not None and branch not in remote_heads(origin_path()):
            # GitHub refuses a default branch that does not exist yet.
            sys.stderr.write("HTTP 422: The branch %s was not found. "
                             "Please push that ref first or create it via the Git Data API.\n"
                             % branch)
            sys.exit(1)
        state.update(changes)
        save(state)
        print("Edited repository %s" % state["repo"])
        return

    if command == "label":
        # The repository's labels are modelled because the gate script creates
        # the kit's label set and has to be seen creating each one once, and
        # saying which it could not create. An issue still carries whatever
        # names it is given, as before: the stand-in does not refuse a label
        # the repository lacks, so a scenario never fails over a label nobody
        # created first.
        label_command(argv, state)
        return

    if command == "api":
        # The path is not always argv[1]: -X POST and --method POST come first.
        path = ""
        for arg in argv[1:]:
            # A field such as ref=refs/heads/main carries a slash too.
            if not arg.startswith("-") and "/" in arg and not re.match(r"^[\w\[\]]+=", arg):
                path = arg
                break
        posting = bool(re.search(r"(?:-X|--method)[= ]POST\b", " ".join(argv)))
        # Deleting a comment by its id, as a run does with its own claim
        # comment when another run claimed the piece first.
        # The comments on one piece, listed with their numeric ids, or one added.
        listed = re.fullmatch(r"/?repos/[^/]+/[^/]+/issues/(\d+)/comments", path)
        if listed:
            issue = find(state, listed.group(1))
            if issue is None:
                unsupported(argv, "no such issue")
            if posting:
                body = api_fields(argv).get("body")
                if body is None:
                    unsupported(argv, "no body given for the comment")
                made = add_comment(state, issue, body)
                save(state)
                print(json.dumps(rest_comment(state, issue, len(issue["comments"]) - 1, made)))
                return
            print(json.dumps([rest_comment(state, issue, n, c)
                              for n, c in enumerate(issue.get("comments", []))]))
            return
        # The label events on one piece, each with the account that made it.
        events = re.fullmatch(r"/?repos/[^/]+/[^/]+/issues/(\d+)/events", path)
        if events and not posting:
            issue = find(state, events.group(1))
            if issue is None:
                sys.stderr.write('{"message":"Not Found","status":"404"}\n'
                                 "gh: Not Found (HTTP 404)\n")
                sys.exit(1)
            print(json.dumps([rest_event(e) for e in issue.get("events", [])]))
            return
        gone = re.fullmatch(r"/?repos/[^/]+/[^/]+/issues/comments/(\d+)", path)
        if gone and re.search(r"(?:-X|--method)[= ]DELETE\b", " ".join(argv)):
            for issue in state["issues"]:
                comments = issue.get("comments", [])
                for n, c in enumerate(comments):
                    if str(comment_id(issue, n, c)) == gone.group(1):
                        del comments[n]
                        save(state)
                        return
            sys.stderr.write("gh: Not Found (HTTP 404)\n")
            sys.exit(1)
        refs = re.fullmatch(r"/?repos/([^/]+/[^/]+)/git/(refs?)(?:/(.*))?", path)
        if refs:
            api_refs(argv, state, refs.group(1), refs.group(3), refs.group(2))
            return
        blocked = re.search(r"issues/(\d+)/dependencies/blocked_by", path)
        if blocked and posting:
            # Recording a dependency the agent worked out during the run. The
            # real endpoint takes a database id; the kit sends the issue number,
            # so that is what this accepts.
            issue = find(state, blocked.group(1))
            if issue is None:
                unsupported(argv, "no such issue")
            wanted = None
            for arg in argv:
                match = re.match(r"issue_id=(\d+)$", arg)
                if match:
                    wanted = int(match.group(1))
            if wanted is None:
                unsupported(argv, "no issue_id given for the dependency")
            if find(state, wanted) is None:
                unsupported(argv, "no such blocking issue")
            if wanted not in issue.setdefault("blocked_by", []):
                issue["blocked_by"].append(wanted)
            save(state)
            print(json.dumps(issue_public(state, issue)))
            return
        if blocked:
            issue = find(state, blocked.group(1))
            if issue is None:
                unsupported(argv, "no such issue")
            print(json.dumps([issue_public(state, find(state, b))
                              for b in issue.get("blocked_by", []) if find(state, b)]))
            return
        subs = re.search(r"issues/(\d+)/sub_issues", path)
        if subs and posting:
            # Recording a part of a bigger piece. The real endpoint takes a
            # database id; the kit sends the issue number, mirroring blocked_by.
            issue = find(state, subs.group(1))
            if issue is None:
                unsupported(argv, "no such issue")
            wanted = None
            for arg in argv:
                match = re.match(r"sub_issue_id=(\d+)$", arg)
                if match:
                    wanted = int(match.group(1))
            if wanted is None:
                unsupported(argv, "no sub_issue_id given for the part")
            if find(state, wanted) is None:
                unsupported(argv, "no such sub-issue")
            if wanted not in issue.setdefault("sub_issues", []):
                issue["sub_issues"].append(wanted)
            save(state)
            print(json.dumps(issue_public(state, issue)))
            return
        if subs:
            issue = find(state, subs.group(1))
            if issue is None:
                unsupported(argv, "no such issue")
            print(json.dumps([issue_public(state, find(state, c))
                              for c in issue.get("sub_issues", []) if find(state, c)]))
            return
        patching = bool(re.search(r"(?:-X|--method)[= ]PATCH\b", " ".join(argv)))
        if patching and re.fullmatch(r"repos/[^/]+/[^/]+", path):
            # The same setting through the API, which is the form the setup
            # skill names. Anything else in the body is a setting nobody
            # modelled, so it is refused rather than quietly accepted.
            # The first upload may set the default branch this way too, and
            # only to a branch the repository already has.
            fields = [a for a in argv if re.match(r"^\w+=", a)]
            changes = {}
            for field in fields:
                key, _, value = field.partition("=")
                if field == "delete_branch_on_merge=true":
                    changes["delete_branch_on_merge"] = True
                elif key == "default_branch" and value:
                    changes["default_branch"] = value
                else:
                    unsupported(argv, "unmodelled repo setting")
            if not changes:
                unsupported(argv, "unmodelled repo setting")
            branch = changes.get("default_branch")
            if branch is not None and branch not in remote_heads(origin_path()):
                sys.stderr.write('{"message":"Validation Failed","status":"422"}\n'
                                 "gh: Validation Failed (HTTP 422)\n")
                sys.exit(1)
            state.update(changes)
            save(state)
            answer = {"full_name": state["repo"]}
            answer.update(changes)
            print(json.dumps(answer))
            return
        single = re.fullmatch(r"/?repos/[^/]+/[^/]+/issues/(\d+)", path)
        if single and not posting:
            # One issue, as the gate script reads it before and just before a
            # move. A missing issue answers 404, as on GitHub.
            issue = find(state, single.group(1))
            if issue is None:
                sys.stderr.write('{"message":"Not Found","status":"404"}\n'
                                 "gh: Not Found (HTTP 404)\n")
                sys.exit(1)
            read_issue_for_answer(state, issue)
            print(json.dumps(issue_public(state, issue)))
            return
        if re.search(r"repos/[^/]+/[^/]+/issues($|\?)", path):
            want = "open" if "state=open" in path else None
            print(json.dumps([issue_public(state, i) for i in state["issues"]
                              if want is None or i["state"] == want]))
            return
        unsupported(argv, "unmodelled api path")

    if command == "issue":
        sub = argv[1] if len(argv) > 1 else ""

        if sub == "list":
            want = flag(argv, "--state") or "open"
            items = [i for i in state["issues"] if want == "all" or i["state"] == want]
            label = flag(argv, "--label")
            if label:
                items = [i for i in items if label in i.get("labels", [])]
            print(json.dumps([issue_public(state, i) for i in items]))
            return

        if sub == "create":
            issue = {
                "number": state["next"],
                "title": flag(argv, "--title") or "",
                "body": body_of(argv) or "",
                "state": "open",
                "labels": [l for value in flags_all(argv, "--label")
                           for l in value.split(",")],
                "assignees": [a for value in flags_all(argv, "--assignee")
                              for a in value.split(",")],
                "blocked_by": [],
                "sub_issues": [],
            }
            for name in issue["labels"]:
                record_label(state, issue, "labeled", name)
            state["next"] += 1
            state["issues"].append(issue)
            save(state)
            print("https://github.com/%s/issues/%s" % (state["repo"], issue["number"]))
            return

        if sub in ("edit", "close", "reopen", "view") and len(argv) > 2:
            issue = find(state, re.sub(r"\D", "", argv[2]) or "0")
            if issue is None:
                unsupported(argv, "no such issue")
            if sub == "close":
                # The reason is kept, so a piece dropped as not planned can be
                # told from one completed. A --comment lands as a comment.
                issue["state"] = "closed"
                reason = (flag(argv, "--reason") or flag(argv, "-r") or "completed")
                issue["state_reason"] = reason.replace(" ", "_")
                closing = flag(argv, "--comment") or flag(argv, "-c")
                if closing is not None:
                    add_comment(state, issue, closing)
            elif sub == "reopen":
                issue["state"] = "open"
            elif sub == "view":
                read_issue_for_answer(state, issue)
                # The comments come with the view, so a run can read back the
                # claim it just made, as `--json comments` does on GitHub.
                shown = issue_public(state, issue)
                # As on GitHub, the id here is the comment's node id. The
                # numeric id a deletion takes comes from the REST listing.
                shown["comments"] = [
                    {"id": comment_node(comment_id(issue, n, c)),
                     "author": {"login": comment_author(c)},
                     "body": comment_body(c),
                     "url": "https://github.com/%s/issues/%s#issuecomment-%s"
                            % (state["repo"], issue["number"], comment_id(issue, n, c))}
                    for n, c in enumerate(issue.get("comments", []))]
                print(json.dumps(shown))
                save(state)
                return
            else:
                # An account without write access is refused a label change.
                if fault(state, "refuse_label_write") and (
                        "--add-label" in argv or "--remove-label" in argv):
                    sys.stderr.write("HTTP 403: Resource not accessible by integration "
                                     "(https://api.github.com/graphql)\n")
                    sys.exit(1)
                for value in flags_all(argv, "--add-label"):
                    for name in value.split(","):
                        if name not in issue["labels"]:
                            issue["labels"].append(name)
                            record_label(state, issue, "labeled", name)
                for value in flags_all(argv, "--remove-label"):
                    for name in value.split(","):
                        if name in issue["labels"]:
                            issue["labels"].remove(name)
                            record_label(state, issue, "unlabeled", name)
                for value in flags_all(argv, "--add-assignee"):
                    for name in value.split(","):
                        if name not in issue["assignees"]:
                            issue["assignees"].append(name)
                for value in flags_all(argv, "--remove-assignee"):
                    for name in value.split(","):
                        if name in issue["assignees"]:
                            issue["assignees"].remove(name)
                body = body_of(argv)
                if body is not None:
                    issue["body"] = body
            save(state)
            print("https://github.com/%s/issues/%s" % (state["repo"], issue["number"]))
            return

        if sub == "comment" and len(argv) > 2:
            issue = find(state, re.sub(r"\D", "", argv[2]) or "0")
            if issue is None:
                unsupported(argv, "no such issue")
            comments = issue.setdefault("comments", [])
            if fault(state, "refuse_comment"):
                sys.stderr.write("HTTP 403: Resource not accessible by integration "
                                 "(https://api.github.com/graphql)\n")
                sys.exit(1)
            if "--delete-last" in argv:
                # A run that lost a claim race deletes its own claim comment.
                # The stand-in has one author, so the last comment is its own.
                if not comments:
                    sys.stderr.write("no comments found for current user\n")
                    sys.exit(1)
                comments.pop()
                save(state)
                return
            made = add_comment(state, issue, body_of(argv) or "")
            save(state)
            print("https://github.com/%s/issues/%s#issuecomment-%s"
                  % (state["repo"], issue["number"], made["id"]))
            return

        unsupported(argv, "unmodelled issue subcommand")

    if command == "pr":
        sub = argv[1] if len(argv) > 1 else ""
        if sub == "create":
            # "Closes #N" does nothing yet. GitHub closes the issue when the
            # pull request merges, and closing it here told the kit a piece was
            # done while its fix sat unmerged.
            body = body_of(argv) or ""
            base = flag(argv, "--base") or "main"
            refuse_base(argv, base)
            pr = {
                "number": len(pulls(state)) + 1,
                "title": flag(argv, "--title") or "",
                "body": body,
                "head": flag(argv, "--head") or current_branch(),
                "base": base,
                "state": "OPEN",
            }
            pulls(state).append(pr)
            save(state)
            print(pr_url(state, pr))
            return

        if sub == "view":
            target = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else ""
            pr = find_pr(state, target)
            if pr is None and not target:
                # Asked about the current branch with nothing to match. The kit
                # reaches for this straight after opening one, so answer with
                # the newest and leave a line saying the branch did not match.
                if pulls(state):
                    pr = pulls(state)[-1]
                    note("ASSUMED\tpr view on branch '%s' answered with #%s"
                         % (current_branch(), pr["number"]))
            if pr is None:
                sys.stderr.write(
                    "no pull requests found for branch \"%s\"\n"
                    % (target or current_branch()))
                sys.exit(1)
            names = (flag(argv, "--json") or "").split(",")
            names = [n for n in names if n]
            if names:
                chosen, unknown = pr_fields(state, pr, names)
                if unknown:
                    unsupported(argv, "unmodelled pr fields: %s" % ",".join(unknown))
                print(json.dumps(chosen))
            else:
                print("%s #%s\n%s\n%s" % (pr.get("title", ""), pr["number"],
                                          pr.get("state", "OPEN"), pr_url(state, pr)))
            return

        if sub == "checks":
            target = argv[2] if len(argv) > 2 and not argv[2].startswith("-") else ""
            pr = find_pr(state, target)
            if pr is None:
                sys.stderr.write(
                    "no pull requests found for branch \"%s\"\n"
                    % (target or current_branch()))
                sys.exit(1)
            # The real CLI writes one tab-separated row per check and exits 0
            # when they all pass.
            print("project-check\tpass\t0s\t%s/checks" % pr_url(state, pr))
            return

        if sub == "edit" and len(argv) > 2:
            pr = find_pr(state, argv[2])
            if pr is None:
                unsupported(argv, "no such pull request")
            title = flag(argv, "--title")
            if title is not None:
                pr["title"] = title
            body = body_of(argv)
            if body is not None:
                pr["body"] = body
            # A stacked pull request is moved onto main once the piece under it
            # has merged, as the merge rule says.
            base = flag(argv, "--base")
            if base is not None:
                refuse_base(argv, base)
                pr["base"] = base
            save(state)
            print(pr_url(state, pr))
            return

        if sub == "merge" and len(argv) > 2:
            pr = find_pr(state, argv[2])
            if pr is None:
                unsupported(argv, "no such pull request")
            if pr.get("state") != "OPEN":
                sys.stderr.write("Pull request #%s is not open\n" % pr["number"])
                sys.exit(1)
            if not land_on_remote(pr):
                sys.stderr.write("Pull request #%s is not mergeable\n" % pr["number"])
                sys.exit(1)
            pr["head_oid"] = head_oid(pr)
            pr["state"] = "MERGED"
            for number in re.findall(r"[Cc]loses #(\d+)", pr.get("body", "")):
                issue = find(state, number)
                if issue:
                    issue["state"] = "closed"
            save(state)
            print("Merged pull request #%s" % pr["number"])
            return

        if sub == "list":
            # --state, --base and --head filter as on GitHub, so a run can find
            # the pull requests stacked on a piece's branch. --json picks the
            # fields and refuses one nobody modelled, as pr view does.
            want = (flag(argv, "--state") or "open").upper()
            if want not in ("OPEN", "MERGED", "CLOSED", "ALL"):
                unsupported(argv, "unmodelled pr list state")
            base, head = flag(argv, "--base"), flag(argv, "--head")
            chosen = [pr for pr in pulls(state)
                      if (want == "ALL" or pr.get("state", "OPEN") == want)
                      and (base is None or pr.get("base", "main") == base)
                      and (head is None or pr.get("head") == head)]
            names = [n for n in (flag(argv, "--json") or "").split(",") if n]
            if not names:
                names = ["number", "title", "state", "headRefName"]
            _, unknown = pr_fields(state, {"number": 0}, names)
            if unknown:
                unsupported(argv, "unmodelled pr fields: %s" % ",".join(unknown))
            print(json.dumps([pr_fields(state, pr, names)[0] for pr in chosen]))
            return
        if sub == "status":
            print("[]")
            return
        unsupported(argv, "unmodelled pr subcommand")

    unsupported(argv, "unmodelled command")


if __name__ == "__main__":
    main()
