#!/usr/bin/env sh
# A stand-in for macOS pmset. It answers `-g batt` and `-g assertions`.
power=${FAKE_COMPUTER_POWER:-ac}
sleep_state=${FAKE_COMPUTER_SLEEP:-held}
case "$*" in
  "-g batt")
    if [ "$power" = battery ]; then
      echo "Now drawing from 'Battery Power'"
      printf ' -InternalBattery-0 (id=4653155)\t87%%; discharging; 5:12 remaining present: true\n'
    else
      echo "Now drawing from 'AC Power'"
      printf ' -InternalBattery-0 (id=4653155)\t100%%; charged; 0:00 remaining present: true\n'
    fi
    ;;
  "-g assertions")
    held=0
    [ "$sleep_state" = held ] && held=1
    echo "Assertion status system-wide:"
    echo "   BackgroundTask                 0"
    echo "   PreventUserIdleSystemSleep     $held"
    echo "   PreventSystemSleep             0"
    echo "   PreventUserIdleDisplaySleep    0"
    ;;
  *)
    echo "pmset stand-in: it answers only -g batt and -g assertions" >&2
    exit 64
    ;;
esac
