#!/usr/bin/env python3
"""A stand-in for the `claude` command, for tests that must not call a model.

It does not think. It replays one scripted attempt, named by FAKE_CLAUDE_SCRIPT,
a JSON file with four optional parts:

  files    a map of project-relative path to the text to write
  commits  a list of {"message": ..., "paths": [...]}; each is one commit
  handoff  {"path": ..., "content": ...}; written and left unsaved
  runs     a list of command lines, each a list of words, run in order in the
           project folder with the environment the stand-in was given. A builder
           uses this to run the hand-off script. A command that fails ends the
           session with exit code 1.

A script may also hold these, which a run test uses:

  sleep      seconds to wait before anything else; a stop signal ends the wait
  cost_usd   the cost to report as total_cost_usd, in the shape of `claude -p` output
  exit_code  the exit code to end with, after the rest of the script ran
  sequence   a list of scripts; the Nth session in the same folder replays the Nth one
             (the last one repeats)

With FAKE_CLAUDE_DIR set and no FAKE_CLAUDE_SCRIPT, the script is a file in that folder,
chosen by the name of the folder the session runs in (a piece's worktree is `<n>-<name>`):
`<name>.json`, then `trim.json` for a folder ending in `-trim`, else `<n>.json`, then
`default.json`. `claude --version` answers with FAKE_CLAUDE_VERSION (default 2.1.219).

It writes one JSON line for each call to FAKE_CLAUDE_LOG (the arguments, the
folder, the names of the environment variables, never their values, and whether
a script was set), and prints a result in the shape of
`claude -p --output-format json`.

It refuses, with exit code 3, a script that writes outside the project, and,
with exit code 2, a call that has no script. It does not enforce the sandbox.
Every sandbox claim needs its own smoke test with the real `claude`.
"""

import json
import os
import re
import subprocess
import sys
import time
from pathlib import Path
from typing import Any


def log(argv: list[str], script: str | None) -> None:
    target = os.environ.get("FAKE_CLAUDE_LOG")
    if not target:
        return
    entry = {
        "argv": argv,
        "cwd": os.getcwd(),
        "script": script,
        "env_keys": sorted(os.environ),
    }
    with open(target, "a", encoding="utf-8") as handle:
        handle.write(json.dumps(entry, sort_keys=True) + "\n")


def inside(project: Path, relative: str) -> Path:
    """The path under the project, or a refusal."""
    if os.path.isabs(relative):
        raise PermissionError(f"{relative!r} is an absolute path")
    target = (project / relative).resolve()
    if project.resolve() not in (target, *target.parents):
        raise PermissionError(f"{relative!r} is outside the project")
    return target


def write(project: Path, relative: str, text: str) -> None:
    target = inside(project, relative)
    target.parent.mkdir(parents=True, exist_ok=True)
    target.write_text(text, encoding="utf-8")


def git(project: Path, *args: str) -> None:
    subprocess.run(["git", "-C", str(project), *args], check=True, capture_output=True)


def replay(project: Path, script: dict[str, Any]) -> list[str]:
    done: list[str] = []
    for relative in script.get("files", {}):
        inside(project, relative)  # refuse every bad path before writing any file
    for commit in script.get("commits", []):
        for relative in commit["paths"]:
            inside(project, relative)
    handoff = script.get("handoff")
    if handoff:
        inside(project, handoff["path"])

    for relative, text in script.get("files", {}).items():
        write(project, relative, text)
        done.append(f"wrote {relative}")
    for commit in script.get("commits", []):
        git(project, "add", "--", *commit["paths"])
        git(project, "commit", "-q", "-m", commit["message"])
        done.append(f"committed {commit['message']}")
    if handoff:
        write(project, handoff["path"], handoff["content"])
        done.append(f"left a hand-off at {handoff['path']}")
    for words in script.get("runs", []):
        ran = subprocess.run(words, cwd=project, check=False, capture_output=True, text=True)
        if ran.returncode != 0:
            raise RuntimeError(f"{words[-1:]} exited {ran.returncode}: {ran.stderr.strip()}")
        done.append(f"ran {Path(words[1]).name if len(words) > 1 else words[0]}")
    return done


def pick_script() -> str | None:
    """The script for this call: FAKE_CLAUDE_SCRIPT, else a file in FAKE_CLAUDE_DIR."""
    path = os.environ.get("FAKE_CLAUDE_SCRIPT")
    if path:
        return path
    folder = os.environ.get("FAKE_CLAUDE_DIR")
    if not folder:
        return None
    name = Path.cwd().name
    leading = re.match(r"(\d+)(-.*)?$", name)
    wanted = [f"{name}.json"]
    if re.search(r"-trim(-\d+)?$", name):
        wanted.append("trim.json")
    elif leading:
        wanted.append(f"{leading.group(1)}.json")
    wanted.append("default.json")
    for candidate in wanted:
        if (Path(folder) / candidate).is_file():
            return str(Path(folder) / candidate)
    return None


def choose(script: dict[str, Any], path: str) -> dict[str, Any]:
    """The Nth script of a sequence, counted for the folder the session runs in."""
    sequence = script.get("sequence")
    if not sequence:
        return script
    counter = Path(path).with_name(f".calls-{Path(path).stem}-{Path.cwd().name}")
    count = int(counter.read_text()) if counter.exists() else 0
    counter.write_text(str(count + 1))
    chosen: dict[str, Any] = sequence[min(count, len(sequence) - 1)]
    return chosen


def main() -> int:
    argv = sys.argv[1:]
    if argv == ["--version"]:
        print(f"{os.environ.get('FAKE_CLAUDE_VERSION', '2.1.219')} (Claude Code)")
        return 0
    path = pick_script()
    log(argv, path)
    if not path or not os.path.isfile(path):
        sys.stderr.write(
            "claude (stand-in): no script. Set FAKE_CLAUDE_SCRIPT to a JSON file "
            "(see tests/stand-ins/fake-claude/claude).\n"
        )
        return 2
    with open(path, encoding="utf-8") as handle:
        script = choose(json.load(handle), path)
    if script.get("sleep"):
        time.sleep(float(script["sleep"]))
    try:
        done = replay(Path.cwd(), script)
    except PermissionError as exc:
        sys.stderr.write(f"claude (stand-in): refused. {exc}\n")
        return 3
    except RuntimeError as exc:
        sys.stderr.write(f"claude (stand-in): a scripted command failed. {exc}\n")
        return 1
    except subprocess.CalledProcessError as exc:
        sys.stderr.write(f"claude (stand-in): git failed: {exc.stderr.decode(errors='replace')}\n")
        return 1
    result: dict[str, Any] = {
        "type": "result",
        "subtype": "success",
        "is_error": False,
        "result": "; ".join(done) or "nothing to do",
        "session_id": "stand-in-session",
    }
    if "cost_usd" in script:
        result["total_cost_usd"] = script["cost_usd"]
        result["usage"] = {"input_tokens": 100, "output_tokens": 50}
    print(json.dumps(result))
    return int(script.get("exit_code", 0))


if __name__ == "__main__":
    sys.exit(main())
