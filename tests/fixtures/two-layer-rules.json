{
  "about": "Each rule the kit must hold twice. layer1 is what the settings template says (deny or ask). guard is what kit/hooks/guard.py says (deny or ask), or none with other_layer naming the layer that holds it instead. Paths use {main}, {work}, {home}, {data} and {kit}.",
  "rules": [
    {"id": "no-push-to-main", "template": "claude-settings", "tool": "Bash", "input": "git push origin main", "layer1": "deny", "guard": "deny"},
    {"id": "no-push-to-main-plus", "template": "claude-settings", "tool": "Bash", "input": "git push origin +main", "layer1": "deny", "guard": "deny"},
    {"id": "no-push-head-to-main", "template": "claude-settings", "tool": "Bash", "input": "git push origin HEAD:main", "layer1": "deny", "guard": "deny"},
    {"id": "no-force-push", "template": "claude-settings", "tool": "Bash", "input": "git push --force origin feature", "layer1": "deny", "guard": "deny"},
    {"id": "no-short-force-push", "template": "claude-settings", "tool": "Bash", "input": "git push -f origin feature", "layer1": "deny", "guard": "deny"},
    {"id": "no-reset-hard", "template": "claude-settings", "tool": "Bash", "input": "git reset --hard HEAD", "layer1": "deny", "guard": "deny"},
    {"id": "no-clean-force", "template": "claude-settings", "tool": "Bash", "input": "git clean -fd", "layer1": "deny", "guard": "deny"},
    {"id": "no-recursive-delete", "template": "claude-settings", "tool": "Bash", "input": "rm -rf build", "layer1": "deny", "guard": "deny"},
    {"id": "no-recursive-delete-long", "template": "claude-settings", "tool": "Bash", "input": "rm --recursive build", "layer1": "deny", "guard": "deny"},
    {"id": "no-reflog-expire", "template": "claude-settings", "tool": "Bash", "input": "git reflog expire --expire=now --all", "layer1": "deny", "guard": "deny"},
    {"id": "no-gc-prune", "template": "claude-settings", "tool": "Bash", "input": "git gc --prune=now", "layer1": "deny", "guard": "deny"},
    {"id": "no-hand-written-state-label", "template": "claude-settings", "tool": "Bash", "input": "gh issue edit 12 --add-label state:ready", "layer1": "deny", "guard": "deny"},
    {"id": "no-state-label-create", "template": "claude-settings", "tool": "Bash", "input": "gh label create state:done", "layer1": "deny", "guard": "deny"},
    {"id": "no-commit-no-verify", "template": "claude-settings", "tool": "Bash", "input": "git commit --no-verify -m x", "layer1": "deny", "guard": "deny"},
    {"id": "no-commit-no-verify-last", "template": "claude-settings", "tool": "Bash", "input": "git commit -m x --no-verify", "layer1": "deny", "guard": "deny"},
    {"id": "no-commit-short-no-verify", "template": "claude-settings", "tool": "Bash", "input": "git commit -n -m x", "layer1": "deny", "guard": "deny"},
    {"id": "no-hooks-path", "template": "claude-settings", "tool": "Bash", "input": "git config core.hooksPath /tmp/none", "layer1": "deny", "guard": "deny"},
    {"id": "no-hooks-path-global", "template": "claude-settings", "tool": "Bash", "input": "git config --global core.hooksPath /tmp/none", "layer1": "deny", "guard": "deny"},
    {"id": "no-alias", "template": "claude-settings", "tool": "Bash", "input": "git config alias.st status", "layer1": "deny", "guard": "deny"},
    {"id": "no-alias-global", "template": "claude-settings", "tool": "Bash", "input": "git config --global alias.st status", "layer1": "deny", "guard": "deny"},
    {"id": "ask-before-merge", "template": "merge-ask-rules", "tool": "Bash", "input": "gh pr merge 12 --squash", "layer1": "ask", "guard": "deny"},
    {"id": "no-merge-by-an-agent-0", "template": "claude-settings", "tool": "Bash", "input": "gh pr merge 12 --squash", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-1", "template": "builder-settings", "tool": "Bash", "input": "gh pr merge 12 --squash", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-2", "template": "claude-settings", "tool": "Bash", "input": "gh api -X PUT repos/o/r/pulls/12/merge", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-3", "template": "claude-settings", "tool": "Bash", "input": "python3 -m loop.run.pull_request merge --run night-1 --said merge", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-4", "template": "builder-settings", "tool": "Bash", "input": "python3 -m loop.run.pull_request merge --run night-1 --said merge", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-5", "template": "claude-settings", "tool": "Bash", "input": "python3 {kit}/scripts/gate.py move 3 done --option merge=agent --option said=merge", "layer1": "deny", "guard": "deny"},
    {"id": "no-merge-by-an-agent-6", "template": "builder-settings", "tool": "Bash", "input": "python3 {kit}/scripts/gate.py move 3 done --option merge=agent --option said=merge", "layer1": "deny", "guard": "deny"},
    {"id": "guard-settings-file", "template": "claude-settings", "tool": "Edit", "input": "{main}/.claude/settings.json", "layer1": "deny", "guard": "deny"},
    {"id": "guard-local-settings-file", "template": "claude-settings", "tool": "Write", "input": "{main}/.claude/settings.local.json", "layer1": "deny", "guard": "deny"},
    {"id": "guard-settings-file-in-worktree", "template": "claude-settings", "tool": "Edit", "input": "{work}/.claude/settings.json", "layer1": "deny", "guard": "deny"},
    {"id": "guard-workflows", "template": "claude-settings", "tool": "Edit", "input": "{main}/.github/workflows/v1-checks.yml", "layer1": "deny", "guard": "deny"},
    {"id": "guard-git-hooks", "template": "claude-settings", "tool": "Edit", "input": "{main}/.githooks/pre-push", "layer1": "deny", "guard": "deny"},
    {"id": "guard-policy-file", "template": "claude-settings", "tool": "Edit", "input": "{main}/.agents/loop/policy.json", "layer1": "deny", "guard": "deny"},
    {"id": "guard-piece-records", "template": "claude-settings", "tool": "Edit", "input": "{main}/.agents/pieces/3/evidence.jsonl", "layer1": "deny", "guard": "deny"},
    {"id": "guard-installed-kit-hooks", "template": "claude-settings", "tool": "Edit", "input": "{kit}/hooks/guard.py", "layer1": "deny", "guard": "deny"},
    {"id": "guard-installed-kit-gate", "template": "claude-settings", "tool": "Write", "input": "{kit}/scripts/gate.py", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-held-out-read", "template": "builder-settings", "tool": "Read", "input": "{data}/held-out/case-1.json", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-held-out-write", "template": "builder-settings", "tool": "Write", "input": "{data}/held-out/case-1.json", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-app-key-read", "template": "builder-settings", "tool": "Read", "input": "{data}/app-key.pem", "layer1": "deny", "guard": "deny"},
    {"id": "attended-no-gh-config-read", "template": "claude-settings", "tool": "Read", "input": "{home}/.config/gh/hosts.yml", "layer1": "deny", "guard": "deny"},
    {"id": "attended-no-keychain-read", "template": "claude-settings", "tool": "Read", "input": "{home}/Library/Keychains/login.keychain-db", "layer1": "deny", "guard": "deny"},
    {"id": "attended-no-gh-auth-token", "template": "claude-settings", "tool": "Bash", "input": "gh auth token", "layer1": "deny", "guard": "deny"},
    {"id": "attended-no-keychain-password", "template": "claude-settings", "tool": "Bash", "input": "security find-internet-password -s github.com -w", "layer1": "deny", "guard": "deny"},
    {"id": "attended-no-keychain-generic", "template": "claude-settings", "tool": "Bash", "input": "security find-generic-password -s gh:github.com -w", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-gh-config-read", "template": "builder-settings", "tool": "Read", "input": "{home}/.config/gh/hosts.yml", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-keychain-read", "template": "builder-settings", "tool": "Read", "input": "{home}/Library/Keychains/login.keychain-db", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-local-settings-read", "template": "builder-settings", "tool": "Read", "input": "{main}/.agents/loop/local.json", "layer1": "deny", "guard": "none", "other_layer": "the sandbox read-block on the same file"},
    {"id": "builder-no-run-folder-write", "template": "builder-settings", "tool": "Edit", "input": "{main}/.agents/runs/night-1/run.json", "layer1": "deny", "guard": "deny"},
    {"id": "builder-no-run-log-write", "template": "builder-settings", "tool": "Write", "input": "{main}/.agents/runs/night-1/commands.log", "layer1": "deny", "guard": "none", "other_layer": "the sandbox, which allows one hand-off file in the run folder and no other write there"},
    {"id": "ask-issue-create", "template": "merge-ask-rules", "tool": "Bash", "input": "gh issue create --title x --body y", "layer1": "ask", "guard": "ask"},
    {"id": "ask-pr-create", "template": "merge-ask-rules", "tool": "Bash", "input": "gh pr create --fill", "layer1": "ask", "guard": "ask"},
